		"string-width": "9.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/bun": "1.4.5",
		"typescript": "7.0.2"
	},
	"overrides": {
		"ansi-regex": "6.6.0",
		"get-east-asian-width": "1.7.0",
		"strip-ansi": "7.2.0",
		"bun-types": "1.4.5",
		"@types/node": "26.6.6",
		"undici-types": "8.9.0"
	}
}
