{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"overrides": [
		{
			"includes": ["plugin/core/wrap.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						// ANSI and OSC parsing intentionally matches terminal control bytes.
						"noControlCharactersInRegex": "off"
					}
				}
			}
		}
	]
}
